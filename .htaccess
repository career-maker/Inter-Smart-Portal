# Defence in depth: this folder is the project checkout, not a website.
# The API is served through the symlinks in the parent /api folder, which are not affected by this file.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
