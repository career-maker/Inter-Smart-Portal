{
  "name": "intersmart-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop app for the Inter Smart portal (same live site and database as the web version)",
  "author": "Intersmart",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "in.intersmart.portal.desktop",
    "productName": "Inter Smart Portal",
    "files": ["main.js", "preload.js", "offline.html", "build/icon.png"],
    "win": { "target": "nsis", "icon": "build/icon.png", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Inter Smart Portal" },
    "directories": { "output": "dist" }
  }
}
